rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserSyncProfile(data) {
      return data.keys().hasAll([
          'ownerId',
          'displayName',
          'preferredPlatform',
          'preferredQuality',
          'preferredVoiceover',
          'theme',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'displayName',
          'preferredPlatform',
          'preferredQuality',
          'preferredVoiceover',
          'theme',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.preferredPlatform is string
        && data.preferredPlatform.size() >= 3
        && data.preferredPlatform.size() <= 20
        && (data.preferredPlatform == 'macos' || data.preferredPlatform == 'windows' || data.preferredPlatform == 'android')
        && data.preferredQuality is string
        && data.preferredQuality.size() >= 4
        && data.preferredQuality.size() <= 10
        && (data.preferredQuality == '2160p' || data.preferredQuality == '1080p' || data.preferredQuality == '720p' || data.preferredQuality == '480p')
        && data.preferredVoiceover is string
        && data.preferredVoiceover.size() >= 2
        && data.preferredVoiceover.size() <= 60
        && data.theme is string
        && data.theme.size() >= 4
        && data.theme.size() <= 10
        && (data.theme == 'dark' || data.theme == 'light')
        && data.updatedAt == request.time;
    }

    function isValidWatchHistoryEntry(data) {
      return data.keys().hasAll([
          'ownerId',
          'animeId',
          'animeTitle',
          'episodeNumber',
          'episodeTitle',
          'voiceover',
          'quality',
          'sourceSite',
          'progressSeconds',
          'durationSeconds',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'animeId',
          'animeTitle',
          'episodeNumber',
          'episodeTitle',
          'voiceover',
          'quality',
          'sourceSite',
          'progressSeconds',
          'durationSeconds',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.animeId is string
        && data.animeId.size() >= 1
        && data.animeId.size() <= 80
        && data.animeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.animeTitle is string
        && data.animeTitle.size() >= 1
        && data.animeTitle.size() <= 160
        && data.episodeNumber is number
        && data.episodeNumber >= 1
        && data.episodeNumber <= 5000
        && data.episodeTitle is string
        && data.episodeTitle.size() >= 1
        && data.episodeTitle.size() <= 160
        && data.voiceover is string
        && data.voiceover.size() >= 1
        && data.voiceover.size() <= 60
        && data.quality is string
        && data.quality.size() >= 4
        && data.quality.size() <= 10
        && (data.quality == '2160p' || data.quality == '1080p' || data.quality == '720p' || data.quality == '480p')
        && data.sourceSite is string
        && data.sourceSite.size() >= 5
        && data.sourceSite.size() <= 30
        && (data.sourceSite == 'YummyAnime.TV' || data.sourceSite == 'AnimeGO' || data.sourceSite == 'AnimeVost.org')
        && data.progressSeconds is number
        && data.progressSeconds >= 0
        && data.progressSeconds <= 86400
        && data.durationSeconds is number
        && data.durationSeconds >= 1
        && data.durationSeconds <= 86400
        && data.updatedAt == request.time;
    }

    function isValidDownloadQueueEntry(data) {
      return data.keys().hasAll([
          'ownerId',
          'animeId',
          'animeTitle',
          'episodeNumber',
          'episodeTitle',
          'voiceover',
          'quality',
          'sourceSite',
          'status',
          'progressPercent',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'animeId',
          'animeTitle',
          'episodeNumber',
          'episodeTitle',
          'voiceover',
          'quality',
          'sourceSite',
          'status',
          'progressPercent',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.animeId is string
        && data.animeId.size() >= 1
        && data.animeId.size() <= 80
        && data.animeId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.animeTitle is string
        && data.animeTitle.size() >= 1
        && data.animeTitle.size() <= 160
        && data.episodeNumber is number
        && data.episodeNumber >= 1
        && data.episodeNumber <= 5000
        && data.episodeTitle is string
        && data.episodeTitle.size() >= 1
        && data.episodeTitle.size() <= 160
        && data.voiceover is string
        && data.voiceover.size() >= 1
        && data.voiceover.size() <= 60
        && data.quality is string
        && data.quality.size() >= 4
        && data.quality.size() <= 10
        && (data.quality == '2160p' || data.quality == '1080p' || data.quality == '720p' || data.quality == '480p')
        && data.sourceSite is string
        && data.sourceSite.size() >= 5
        && data.sourceSite.size() <= 30
        && (data.sourceSite == 'YummyAnime.TV' || data.sourceSite == 'AnimeGO' || data.sourceSite == 'AnimeVost.org')
        && data.status is string
        && data.status.size() >= 5
        && data.status.size() <= 20
        && (data.status == 'queued' || data.status == 'downloading' || data.status == 'paused' || data.status == 'completed')
        && data.progressPercent is number
        && data.progressPercent >= 0
        && data.progressPercent <= 100
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserSyncProfile(incoming());
      allow update: if isVerifiedUser()
        && isValidUserSyncProfile(incoming())
        && isOwner(userId)
        && isValidId(userId)
        && incoming().ownerId == existing().ownerId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'preferredPlatform',
          'preferredQuality',
          'preferredVoiceover',
          'theme',
          'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isOwner(userId) && isValidId(userId);

      match /watchHistory/{historyId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow list: if isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && isValidWatchHistoryEntry(incoming())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidWatchHistoryEntry(incoming())
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && incoming().ownerId == existing().ownerId
          && incoming().animeId == existing().animeId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'animeTitle',
            'episodeNumber',
            'episodeTitle',
            'voiceover',
            'quality',
            'sourceSite',
            'progressSeconds',
            'durationSeconds',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(historyId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }

      match /downloadQueue/{taskId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow list: if isOwner(userId)
          && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && isValidDownloadQueueEntry(incoming())
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidDownloadQueueEntry(incoming())
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && incoming().ownerId == existing().ownerId
          && incoming().animeId == existing().animeId
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'voiceover',
            'quality',
            'status',
            'progressPercent',
            'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
        allow delete: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(taskId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
      }
    }
  }
}
